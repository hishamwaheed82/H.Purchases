<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <RootNamespace>H.Purchases</RootNamespace>
    <AssemblyName>H.Purchases.Domain</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Domain" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Emailing" Version="$(AbpVersion)" />
    <ProjectReference Include="..\H.Purchases.Domain.Shared\H.Purchases.Domain.Shared.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(HPlatformSource)' == 'Project'">
    <ProjectReference Include="$(HPlatformProjectRoot)H.Platform.Domain\H.Platform.Domain.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(HPlatformSource)' == 'Package'">
    <PackageReference Include="H.Platform.Domain" Version="$(HPlatformPackageVersion)" />
  </ItemGroup>

</Project>
